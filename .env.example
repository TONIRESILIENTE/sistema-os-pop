# ╔══════════════════════════════════════════════════════╗
# ║   .env.example — PRISMA Platform                     ║
# ║   Copie este arquivo para .env e preencha os valores ║
# ║   Copy this file to .env and fill in the values      ║
# ╚══════════════════════════════════════════════════════╝

# MODO: demo | prisma | sql
MODO=demo

# JWT — Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=GERE_UMA_CHAVE_SECRETA_FORTE_AQUI
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# API do PRISMA (TI fornece)
PRISMA_URL=https://api.suaempresa.com/prisma/v1
PRISMA_TOKEN=Bearer SEU_TOKEN_AQUI

# Banco de dados do ponto biométrico (TI fornece)
DB_TIPO=sqlserver
DB_HOST=192.168.1.100
DB_PORTA=1433
DB_NOME=nome_do_banco
DB_USUARIO=usuario_leitura
DB_SENHA=sua_senha_aqui

# Geral
API_PORTA=8000
